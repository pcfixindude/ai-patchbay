NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-anon-key
# Required in production. Set to "bootstrap" only for explicit offline development.
AI_PATCHBAY_DATA_SOURCE=supabase
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Server-only. Never prefix this with NEXT_PUBLIC_ or commit a real value.
SUPABASE_SERVICE_ROLE_KEY=
# Optional server-only updater credentials. Never prefix these with NEXT_PUBLIC_.
GITHUB_TOKEN=
HUGGINGFACE_TOKEN=
OPENROUTER_API_KEY=
# Optional local runtime endpoint; the Ollama adapter is disabled by default.
OLLAMA_ENDPOINT=http://127.0.0.1:11434
# Hosted Edge dispatcher only; keep all values server-side and out of browser bundles.
ECOSYSTEM_UPDATE_SHARED_SECRET=
ECOSYSTEM_UPDATE_RUNNER_URL=
ECOSYSTEM_UPDATE_RUNNER_SECRET=
